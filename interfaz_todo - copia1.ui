          <bold>true</bold>
         </font>
        </property>
        <property name="styleSheet">
         <string notr="true">QPushButton {
    background-position: center;    /* Centrar la imagen */
    background-repeat: no-repeat;   /* Evitar que se repita la imagen */
    background-size: contain;       /* Cambiar el tamaño de la imagen */
    border: 2px solid #cccccc;                   /* Elimina el borde inicial del botón */
    color: white;                   /* Color del texto */
}

QPushButton:hover {
    background-color: #2980b9;      /* Color de fondo cuando el mouse está sobre el botón */
    color: white;                   /* Color del texto al hacer hover */
    border: 2px solid white;        /* Borde blanco de 2px al hacer hover */
}</string>
        </property>
        <property name="text">
         <string>2</string>
        </property>
       </widget>
